---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import headWatermark from '../../assets/brand/logo-watermark.png';
import { en as t } from '../../i18n/en';
import iMail from 'lucide-static/icons/mail.svg?raw';
import iPhone from 'lucide-static/icons/phone.svg?raw';
import iPin from 'lucide-static/icons/map-pin.svg?raw';

const mapQuery = '166 Otar Chiladze Street, Tbilisi 0160, Georgia';
const mapEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;

const fbPath = 'M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z';
const waPath = 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z';

const cards = [
  {
    title: 'Email',
    icon: iMail,
    lines: [t.contact.email],
    href: `mailto:${t.contact.email}`,
    label: 'Email AID Group',
  },
  {
    title: 'Phone',
    icon: iPhone,
    lines: [t.contact.phone],
    href: t.contact.phoneHref,
    label: 'Call AID Group',
  },
  {
    title: 'Address',
    icon: iPin,
    lines: t.contact.addressLines.map((l, i, all) => (i === all.length - 1 ? l.replace(/\.$/, '') : l)),
  },
];
---
<BaseLayout
  title="Contact Us | AID Group Pharmaceutical Engineering"
  description="Get in touch with AID Group for pharmaceutical facility engineering, GMP consulting, and qualification & validation support."
>
  <section class="contact-head">
    <Image
      class="head-deco"
      src={headWatermark}
      alt=""
      aria-hidden="true"
      widths={[600, 900, 1200]}
      sizes="800px"
      loading="eager"
    />
    <div class="container head-inner">
      <p class="kicker">Contact</p>
      <h1>Contact Us</h1>
      <p class="intro">
        Planning a facility, a GMP upgrade, or a qualification and validation project? Get in touch and we will get back to you.
      </p>
    </div>
  </section>

  <section class="section contact-cards section-shadow">
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>
    <div class="mesh" aria-hidden="true"></div>
    <div class="container cards-inner">
      <ul class="cards">
        {cards.map((c) => (
          <li class="card">
            <span class="mark" set:html={c.icon} aria-hidden="true" />
            <span class="icon" set:html={c.icon} aria-hidden="true" />
            <h2>{c.title}</h2>
            {c.href ? (
              <a class="card-link" href={c.href} aria-label={`${c.label}: ${c.lines[0]}`}>{c.lines[0]}</a>
            ) : (
              <address>
                {c.lines.map((l, i) => (<>{i > 0 && <br />}{l}</>))}
              </address>
            )}
          </li>
        ))}
      </ul>

      <ul class="social-row">
        <li>
          <a class="btn btn-secondary" href={t.contact.whatsapp} target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={waPath} /></svg>
            Message on WhatsApp
          </a>
        </li>
        <li>
          <a class="btn btn-secondary" href={t.facebook} target="_blank" rel="noopener">
            <svg width="15" height="19" viewBox="0 0 320 512" fill="currentColor" aria-hidden="true"><path d={fbPath} /></svg>
            Follow on Facebook
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section map-section section-shadow section-shadow--strong">
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>
    <div class="dots" aria-hidden="true"></div>
    <div class="container map-inner">
      <h2 class="h-underline">Find Us</h2>
      <div class="map-wrap">
        <div class="map" data-map-src={mapEmbedSrc} role="region" aria-label="Map showing the AID Group office location">
          <p class="map-fallback">Map loads as you scroll.</p>
        </div>
      </div>
      <p class="map-link">
        <a class="btn btn-secondary" href={mapLink} target="_blank" rel="noopener">Open in Google Maps</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Inject the Google Maps iframe only when the map area nears the viewport.
  const box = document.querySelector<HTMLElement>('[data-map-src]');
  if (box) {
    const load = () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.mapSrc!;
      f.title = 'AID Group office location on Google Maps';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.allowFullscreen = true;
      box.replaceChildren(f);
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); load(); }
      }, { rootMargin: '300px' });
      io.observe(box);
    } else {
      load();
    }
  }
</script>

<style>
  .contact-head {
    position: relative;
    z-index: 6;
    overflow: hidden;
    padding-block: 72px;
    min-height: 296px;
    box-shadow: var(--shadow-bar);
    background: linear-gradient(180deg, #fff 0%, var(--bg) 30%, var(--bg) 100%);
  }
  .head-deco {
    position: absolute;
    z-index: 0;
    right: max(var(--gutter), calc((100% - var(--container)) / 2 + var(--gutter)));
    top: 50%;
    transform: translateY(-50%);
    height: 260px;
    width: auto;
    max-width: none;
    opacity: 0.2;
    pointer-events: none;
    user-select: none;
  }
  .head-inner { position: relative; z-index: 1; }
  @media (max-width: 767px) {
    .contact-head { padding-block: var(--space-lg); min-height: 288px; }
    .head-deco { right: -25%; height: 180px; opacity: 0.14; }
  }
  .kicker {
    margin: 0 0 var(--space-sm);
    color: var(--teal-dark);
    font: 600 var(--small-size)/var(--small-lh) var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .contact-head h1 { margin-bottom: var(--space-sm); }
  .intro { max-width: 60ch; margin: 0; }

  /* Contact cards + social buttons — light-green band, glow blobs, fine white mesh */
  .contact-cards {
    --section-z: 5;
    overflow: hidden;
    background: linear-gradient(180deg, #e9f5ee 0%, #d7ebdf 100%);
  }
  .glow {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    border-radius: 50%;
  }
  .glow-a {
    width: 560px;
    height: 560px;
    left: -200px;
    top: -240px;
    background: radial-gradient(circle, rgb(79 166 141 / 0.22) 0%, transparent 70%);
  }
  .glow-b {
    width: 640px;
    height: 640px;
    right: -240px;
    bottom: -280px;
    background: radial-gradient(circle, rgb(17 102 159 / 0.22) 0%, transparent 70%);
  }
  .mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.5) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.5) 1px, transparent 1px);
    background-size: 7px 7px;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
  }
  .cards-inner { position: relative; z-index: 1; }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--space-md);
    background: rgb(255 255 255 / 0.55);
    border: 1px solid rgb(17 102 159 / 0.16);
    border-radius: var(--radius-card);
    transition: background-color 0.25s ease, border-color 0.25s ease,
      box-shadow 0.25s ease, transform 0.25s ease;
  }
  /* blue dotted decoration, fading out from the top-right corner, behind the content */
  .card::after {
    content: '';
    position: absolute;
    z-index: -1;
    right: -8px;
    top: -8px;
    width: 200px;
    height: 140px;
    pointer-events: none;
    background-image: radial-gradient(rgb(17 102 159 / 0.38) 1.5px, transparent 1.7px);
    background-size: 11.5px 11.5px;
    -webkit-mask-image: radial-gradient(ellipse at top right, #000 0%, transparent 72%);
    mask-image: radial-gradient(ellipse at top right, #000 0%, transparent 72%);
    opacity: 0.75;
    transition: opacity 0.25s ease;
  }
  /* teal edge bar on the left that grows from the centre on hover */
  .card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--teal-light);
    transform: scaleY(0);
    transition: transform 0.3s ease;
  }
  /* faded icon watermark, bottom-right corner */
  .mark {
    position: absolute;
    z-index: -1;
    right: 14px;
    bottom: 10px;
    width: 76px;
    height: 76px;
    color: var(--blue);
    opacity: 0.12;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.35s ease;
  }
  .mark :global(svg) { display: block; width: 100%; height: 100%; stroke-width: 1.4; }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-bottom: var(--space-sm);
    border-radius: var(--radius-card);
    background: var(--teal-light);
    color: var(--navy-deep);
    transition: transform 0.3s ease;
  }
  .icon :global(svg) { width: 24px; height: 24px; }
  .card h2 { font-size: 19px; margin-bottom: var(--space-xs); }
  .card a, .card address {
    font-style: normal;
    font-size: 17px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .card a { color: var(--blue); text-underline-offset: 3px; }
  /* stretched link: the whole Email / Phone card is clickable, with a card-sized focus ring */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-card);
  }
  .card-link:focus-visible { outline: none; }
  .card-link:focus-visible::after { outline: 3px solid var(--blue); outline-offset: -3px; }

  @media (hover: hover) {
    .card:hover {
      background: rgb(255 255 255 / 0.9);
      border-color: var(--teal-light);
      box-shadow: 0 6px 18px rgb(12 56 93 / 0.12);
      transform: translateY(-2px);
    }
    .card:hover::before { transform: scaleY(1); }
    .card:hover::after { opacity: 1; }
    .card:hover .icon { transform: rotate(-6deg) scale(1.06); }
    .card:hover .mark { opacity: 0.22; transform: scale(1.08) rotate(-4deg); }
  }

  .social-row {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }
  .social-row .btn { display: inline-flex; align-items: center; gap: 10px; }
  /* soft white fill at rest so the outline buttons read as buttons on the blue band; hover is unchanged */
  .social-row .btn:not(:hover):not(:focus-visible) { background: rgb(255 255 255 / 0.6); }

  /* Find Us — light-blue band, glow blobs, dotted corner; the map itself is unchanged */
  .map-section {
    --section-z: 4;
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #e9f2f8 0%, #d8e7f2 100%);
  }
  .map-section .glow-a {
    left: auto;
    right: -200px;
    top: -240px;
    background: radial-gradient(circle, rgb(79 166 141 / 0.22) 0%, transparent 70%);
  }
  .map-section .glow-b {
    right: auto;
    left: -240px;
    bottom: -280px;
    background: radial-gradient(circle, rgb(17 102 159 / 0.2) 0%, transparent 70%);
  }
  .dots {
    position: absolute;
    z-index: 0;
    left: 0;
    top: 0;
    width: 460px;
    height: 280px;
    pointer-events: none;
    background-image: radial-gradient(rgb(17 102 159 / 0.34) 1.5px, transparent 1.7px);
    background-size: 11.5px 11.5px;
    -webkit-mask-image: radial-gradient(ellipse at top left, #000 0%, transparent 72%);
    mask-image: radial-gradient(ellipse at top left, #000 0%, transparent 72%);
  }
  .map-inner { position: relative; z-index: 1; }
  .map-section h2 { margin-bottom: var(--space-md); }

  /* offset teal backing shape behind the map frame, as on the site's photos */
  .map-wrap { position: relative; }
  .map-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(14px, 14px);
    border-radius: var(--radius-card);
    background: var(--teal-light);
    opacity: 0.35;
  }
  .map-wrap .map { position: relative; z-index: 1; }
  .map {
    position: relative;
    width: 100%;
    height: 420px;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--border);
    box-shadow: 0 4px 14px rgb(12 56 93 / 0.08);
    border-bottom: 4px solid var(--teal-light);
  }
  .map :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .map-fallback { margin: 0; padding: var(--space-md); color: var(--text-body); font-size: var(--small-size); }
  .map-link { margin: var(--space-lg) 0 0; text-align: center; }
  .map-link .btn:not(:hover):not(:focus-visible) { background: rgb(255 255 255 / 0.6); }

  @media (prefers-reduced-motion: reduce) {
    .card:hover, .card:hover .icon, .card:hover .mark { transform: none; }
    .card::before { transition: none; }
  }
  @media (max-width: 899px) {
    .cards { grid-template-columns: 1fr; }
    .map { height: 320px; }
    .map-wrap { margin-right: 14px; }
  }
</style>
