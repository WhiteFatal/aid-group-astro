---
import BaseLayout from '../../layouts/BaseLayout.astro';
import labPhoto from '../../assets/images/services_laboratory_environment.jpg';
import headWatermark from '../../assets/brand/logo-watermark.png';
import areasBg from '../../assets/images/areas-aerial-bg.jpg';
import { Image } from 'astro:assets';
import iCheck from 'lucide-static/icons/check.svg?raw';
import iFactory from 'lucide-static/icons/factory.svg?raw';
import iRocket from 'lucide-static/icons/rocket.svg?raw';
import iGlobe from 'lucide-static/icons/globe.svg?raw';
import iHandshake from 'lucide-static/icons/handshake.svg?raw';
import iLandmark from 'lucide-static/icons/landmark.svg?raw';
import iWrench from 'lucide-static/icons/wrench.svg?raw';

const clusters = [
  {
    title: 'GMP/GDP Consulting & Compliance',
    items: [
      'GMP/GDP consulting and compliance support',
      'GMP readiness assessments, gap assessments and internal audits',
      'SOP, protocol and technical/quality documentation development',
      'Training for engineering, production and quality personnel',
    ],
  },
  {
    title: 'Facility & Engineering Design',
    items: [
      'Pharmaceutical facility concept development and layout planning',
      'Production, warehouse, laboratory and technical-area planning',
      'User Requirement Specifications (URS) and technical requirement development',
      'Engineering design coordination and design review',
    ],
  },
  {
    title: 'Utilities & Critical Systems',
    items: [
      'HVAC and cleanroom concept review, zoning, pressure cascades and environmental requirements',
      'Pharmaceutical water systems and other critical utility systems',
      'Compressed air, clean gases and supporting utility systems',
    ],
  },
  {
    title: 'Equipment & Procurement',
    items: [
      'Production and packaging equipment selection and technical evaluation',
      'Vendor assessment, technical bid comparison and procurement support',
    ],
  },
  {
    title: 'Implementation & Commissioning',
    items: [
      'FAT and SAT planning or supervision',
      'Installation, commissioning and start-up support',
    ],
  },
  {
    title: 'Qualification & Validation',
    items: [
      'Qualification and validation planning and execution support, including DQ, IQ, OQ and PQ',
      'Risk assessments, traceability matrices and validation documentation',
    ],
  },
  {
    title: 'Facility Modernization',
    items: [
      'Existing facility modernization, capacity expansion and compliance upgrades',
    ],
  },
];

const facilityTypes = [
  'Solid dosage manufacturing facilities — tablets, capsules and related processes',
  'Primary and secondary pharmaceutical packaging facilities',
  'Pharmaceutical warehouses and GDP-controlled storage areas',
  'Quality-control and support laboratories',
  'Cleanrooms and controlled manufacturing areas',
  'Pilot-scale and development areas',
  'Existing pharmaceutical plants requiring modernization or capacity expansion',
  'Greenfield pharmaceutical projects requiring concept-to-qualification support',
];

const processSteps = [
  'Project concept and feasibility',
  'User requirements and scope definition',
  'Facility and engineering concept',
  'Design coordination and GMP design review',
  'Equipment and contractor technical evaluation',
  'Procurement support',
  'Construction/installation coordination',
  'FAT/SAT and commissioning support',
  'Qualification and validation',
  'GMP readiness and handover to routine operation',
];

const audienceIcons = [iFactory, iRocket, iGlobe, iHandshake, iLandmark, iWrench];
const audiences = [
  'Existing local pharmaceutical manufacturers planning upgrades, expansions or new lines',
  'New pharmaceutical manufacturers and start-up production projects',
  'Foreign investors planning pharmaceutical manufacturing or packaging operations in Georgia or the region',
  'International pharmaceutical companies looking for a local engineering/GMP partner',
  'Investors developing pharmaceutical, laboratory, warehouse or regulated manufacturing facilities',
  'Equipment manufacturers and international engineering companies that need an experienced local project partner',
];
---
<BaseLayout
  title="Services | Pharmaceutical Facility Engineering & Validation"
  description="GMP consulting, facility & utility engineering, equipment selection, and qualification/validation (DQ/IQ/OQ/PQ) for pharmaceutical manufacturers."
>
  <section class="services-head">
    <Image
      class="head-deco"
      src={headWatermark}
      alt=""
      aria-hidden="true"
      widths={[600, 900, 1200]}
      sizes="800px"
      loading="eager"
    />
    <div class="container head-inner">
      <p class="kicker">Services</p>
      <h1>Services</h1>
      <p class="intro">A closer look at how we support pharmaceutical facilities — from early concept and design through qualification and long-term compliance.</p>
    </div>
  </section>

  <section class="section process section-shadow">
    <div class="container">
      <h2 class="h-underline">Our End-to-End Process</h2>
      <p class="lede">AID Group can provide end-to-end support from the earliest project definition through commissioning and qualification. Clients may also engage the company for only selected phases.</p>
      <ol class="steps">
        {processSteps.map((step, i) => (
          <li class="step">
            <div class="step-card" data-n={i + 1}>
              <span class="circle">{i + 1}</span>
              <p>{step}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section scope section-shadow">
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>
    <div class="mesh" aria-hidden="true"></div>
    <div class="container scope-inner">
      <div class="split">
        <div class="copy">
          <h2 class="h-underline">Services and Scope</h2>
          <p class="scope-card">AID Group can support either the complete project lifecycle or selected individual stages, depending on the client's needs.</p>
          <ul class="cluster-lead">
            {clusters.slice(0, 1).map((c) => (
              <li class="cluster-card">
                <h3>{c.title}</h3>
                <ul>
                  {c.items.map((item) => (<li>{item}</li>))}
                </ul>
              </li>
            ))}
          </ul>
        </div>
        <div class="figure">
          <div class="figure-frame">
            <Image src={labPhoto} alt="Pharmaceutical laboratory environment" width={1200} height={800} />
          </div>
        </div>
      </div>
      <ul class="cluster-grid">
        {clusters.slice(1).map((c) => (
          <li class="cluster-card">
            <h3>{c.title}</h3>
            <ul>
              {c.items.map((item) => (<li>{item}</li>))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section facility-types section-shadow section-shadow--strong">
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>
    <div class="container fac-inner">
      <div class="fac-card">
        <h2 class="h-underline">Facility Types We Support</h2>
        <p class="lede">AID Group is primarily oriented toward facilities where GMP compliance, controlled environments, specialized utilities and validated processes are required.</p>
        <ul class="std-grid">
          {facilityTypes.map((f) => (
            <li class="std-item">
              <span class="check" set:html={iCheck} aria-hidden="true" />
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <div class="std-divider" aria-hidden="true"></div>
        <p class="std-note">Sterile, high-containment or other highly specialized facilities can be supported where the project team includes the appropriate verified specialist expertise for the specific technology and regulatory risk level.</p>
      </div>
    </div>
  </section>

  <section class="section audiences-section section-shadow section-shadow--strong">
    <div class="aud-bg" aria-hidden="true">
      <Image src={areasBg} alt="" widths={[700, 1100, 1400]} sizes="100vw" />
    </div>
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>
    <div class="container aud-inner">
      <h2 class="h-underline">Areas of Engagement</h2>
      <ul class="audience-grid">
        {audiences.map((a, i) => (
          <li class="audience-card">
            <span class="mark" set:html={audienceIcons[i]} aria-hidden="true" />
            <span class="aud-text">{a}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .services-head {
    position: relative;
    z-index: 6;
    overflow: hidden;
    padding-block: 72px;
    min-height: 296px;
    box-shadow: var(--shadow-bar-strong);
    background: linear-gradient(180deg, #fff 0%, var(--bg) 30%, var(--bg) 100%);
  }
  .head-deco {
    position: absolute;
    z-index: 0;
    right: max(var(--gutter), calc((100% - var(--container)) / 2 + var(--gutter)));
    top: 50%;
    transform: translateY(-50%);
    height: 260px;
    width: auto;
    max-width: none;
    opacity: 0.2;
    pointer-events: none;
    user-select: none;
  }
  .head-inner { position: relative; z-index: 1; }
  @media (max-width: 767px) {
    .services-head { padding-block: var(--space-lg); min-height: 288px; }
    .head-deco { right: -25%; height: 180px; opacity: 0.14; }
  }
  .kicker {
    margin: 0 0 var(--space-sm);
    color: var(--teal-dark);
    font: 600 var(--small-size)/var(--small-lh) var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .services-head h1 { margin-bottom: var(--space-sm); }
  .intro { max-width: 60ch; margin: 0; }

  /* Services and Scope + Service Clusters (merged) — light-blue band, glow blobs */
  .scope {
    --section-z: 4;
    overflow: hidden;
    background: linear-gradient(180deg, #e9f2f8 0%, #d8e7f2 100%);
  }
  .glow {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    border-radius: 50%;
  }
  .glow-a {
    width: 560px;
    height: 560px;
    left: -200px;
    top: -240px;
    background: radial-gradient(circle, rgb(79 166 141 / 0.22) 0%, transparent 70%);
  }
  .glow-b {
    width: 640px;
    height: 640px;
    right: -240px;
    bottom: -280px;
    background: radial-gradient(circle, rgb(17 102 159 / 0.22) 0%, transparent 70%);
  }
  /* Section-wide fine white mesh, softly faded at the top and bottom edges */
  .mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.5) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.5) 1px, transparent 1px);
    background-size: 7px 7px;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
  }
  .scope-inner { position: relative; z-index: 1; }

  /* Top block: heading + intro + first card on the left, photo on the right */
  .split {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-lg);
    align-items: stretch;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .copy .h-underline {
    align-self: flex-start;
    margin: 0 0 var(--space-xs);
    font-size: calc(var(--h2-size) - 4px);
  }

  /* Shared card style — intro card + all cluster cards */
  .scope-card,
  .cluster-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: 0;
    padding: var(--space-md);
    background: rgb(255 255 255 / 0.55);
    border: 1px solid rgb(17 102 159 / 0.16);
    border-radius: var(--radius-card);
    font-size: calc(var(--body-size) - 1px);
    transition: background-color 0.25s ease, border-color 0.25s ease,
      box-shadow 0.25s ease, transform 0.25s ease;
  }
  /* teal edge bar that grows from the centre on hover */
  .scope-card::before,
  .cluster-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--teal-light);
    transform: scaleY(0);
    transition: transform 0.3s ease;
  }
  /* blue dotted decoration, fading out from the top-right corner, sits behind the text */
  .scope-card::after,
  .cluster-card::after {
    content: '';
    position: absolute;
    z-index: -1;
    right: -8px;
    top: -8px;
    width: 220px;
    height: 150px;
    pointer-events: none;
    background-image: radial-gradient(rgb(17 102 159 / 0.38) 1.5px, transparent 1.7px);
    background-size: 11.5px 11.5px;
    -webkit-mask-image: radial-gradient(ellipse at top right, #000 0%, transparent 72%);
    mask-image: radial-gradient(ellipse at top right, #000 0%, transparent 72%);
    opacity: 0.75;
    transition: opacity 0.25s ease;
  }
  @media (hover: hover) {
    .scope-card:hover,
    .cluster-card:hover {
      background: rgb(255 255 255 / 0.9);
      border-color: var(--teal-light);
      box-shadow: 0 6px 18px rgb(12 56 93 / 0.12);
      transform: translateY(-2px);
    }
    .scope-card:hover::before,
    .cluster-card:hover::before { transform: scaleY(1); }
    .scope-card:hover::after,
    .cluster-card:hover::after { opacity: 1; }
  }

  /* Photo: fills the full height of the left column, offset teal backing shape, hover zoom */
  .figure { position: relative; }
  .figure::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(14px, 14px);
    border-radius: 12px;
    background: var(--teal-light);
    opacity: 0.35;
  }
  .figure-frame {
    position: relative;
    z-index: 1;
    height: 100%;
    min-height: 280px;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 6px 18px rgb(12 56 93 / 0.14);
    border-bottom: 4px solid var(--teal-light);
  }
  .figure-frame :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  @media (hover: hover) {
    .figure:hover .figure-frame :global(img) { transform: scale(1.05); }
  }

  /* Cluster cards */
  .cluster-lead {
    flex: 1;
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cluster-lead .cluster-card { flex: 1; }

  /* Bento grid — 12 columns, cards of different widths; equal height within each row */
  .cluster-grid {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 18px;
  }
  .cluster-grid > :nth-child(1) { grid-column: span 5; }
  .cluster-grid > :nth-child(2) { grid-column: span 7; }
  .cluster-grid > :nth-child(3) { grid-column: span 4; }
  .cluster-grid > :nth-child(4) { grid-column: span 3; }
  .cluster-grid > :nth-child(5) { grid-column: span 5; }
  .cluster-grid > :nth-child(6) {
    grid-column: span 12;
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }
  .cluster-grid > :nth-child(6) h3 { margin: 0; flex: none; }

  .cluster-card h3 { margin: 0 0 var(--space-sm); font-size: calc(var(--h3-size) - 3px); }
  .cluster-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cluster-card li {
    position: relative;
    padding-left: var(--space-sm);
    margin-bottom: var(--space-xs);
    font-size: calc(var(--body-size) - 1px);
    line-height: var(--body-lh);
  }
  .cluster-card li:last-child { margin-bottom: 0; }
  .cluster-card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal-light);
  }

  @media (max-width: 899px) {
    .split { grid-template-columns: 1fr; }
    .figure { order: -1; }
    .figure-frame { height: auto; min-height: 0; aspect-ratio: 3 / 2; }
    .cluster-grid { grid-template-columns: 1fr 1fr; }
    .cluster-grid > :nth-child(n) { grid-column: auto; display: block; }
    .cluster-grid > :nth-child(6) h3 { margin: 0 0 var(--space-sm); }
  }
  @media (max-width: 767px) {
    /* keep the offset backing shape inside the viewport */
    .figure { margin-right: 14px; }
    .cluster-grid { grid-template-columns: 1fr; }
  }

  /* Facility Types — light-green band, glow blobs, one card with a checklist */
  .facility-types {
    --section-z: 3;
    overflow: hidden;
    background: linear-gradient(180deg, #e9f5ee 0%, #d7ebdf 100%);
  }
  .facility-types .glow-a {
    left: auto;
    right: -200px;
    top: -240px;
    background: radial-gradient(circle, rgb(79 166 141 / 0.26) 0%, transparent 70%);
  }
  .facility-types .glow-b {
    right: auto;
    left: -240px;
    bottom: -280px;
    background: radial-gradient(circle, rgb(17 102 159 / 0.14) 0%, transparent 70%);
  }
  .fac-inner { position: relative; z-index: 1; }

  .fac-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--space-lg);
    background: rgb(255 255 255 / 0.72);
    border: 1px solid rgb(31 99 98 / 0.14);
    border-radius: var(--radius-card);
    box-shadow: 0 6px 18px rgb(12 56 93 / 0.1);
  }
  /* dotted decoration, fading out from the top-right corner, behind the text */
  .fac-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    right: -8px;
    top: -8px;
    width: 340px;
    height: 220px;
    pointer-events: none;
    background-image: radial-gradient(rgb(17 102 159 / 0.34) 1.5px, transparent 1.7px);
    background-size: 11.5px 11.5px;
    -webkit-mask-image: radial-gradient(ellipse at top right, #000 0%, transparent 72%);
    mask-image: radial-gradient(ellipse at top right, #000 0%, transparent 72%);
  }
  /* teal edge on the right side: appears only on hover, sweeping down */
  .fac-card::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--teal-light);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.6s ease;
  }
  @media (hover: hover) {
    .fac-card:hover::after { transform: scaleY(1); }
  }
  .fac-card .h-underline { margin-bottom: var(--space-sm); }
  .facility-types .lede { max-width: 72ch; margin: 0 0 var(--space-md); }

  .std-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm) var(--space-lg);
  }
  .std-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }
  /* empty, square checkbox with a check mark that redraws on hover */
  .check {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    border: 2px solid var(--teal-dark);
    border-radius: 0;
    background: transparent;
    color: var(--teal-dark);
  }
  .check :global(svg) { width: 14px; height: 14px; stroke-width: 3.2; }
  .check :global(svg path) { stroke-dasharray: 24; stroke-dashoffset: 0; }
  @media (hover: hover) {
    .std-item:hover .check :global(svg path) { animation: tick 0.45s ease forwards; }
  }
  @keyframes tick {
    from { stroke-dashoffset: 24; }
    to { stroke-dashoffset: 0; }
  }

  /* closing note: separated by a divider, smaller and quieter than the list */
  .std-divider {
    height: 1px;
    margin: var(--space-md) 0 var(--space-sm);
    background: linear-gradient(90deg, var(--teal-light) 0, var(--teal-light) 64px, rgb(12 56 93 / 0.14) 64px);
  }
  .std-note {
    margin: 0;
    max-width: 72ch;
    color: var(--text-body);
    opacity: 0.9;
    font-size: var(--small-size);
    font-style: italic;
    font-weight: 700;
  }

  @media (max-width: 767px) {
    .fac-card { padding: var(--space-md); }
    .std-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .std-item:hover .check :global(svg path) { animation: none; }
    .fac-card::after { transition: none; }
  }

  /* End-to-End Process — dark navy blueprint band (same recipe as Home > Expertise) */
  .process {
    --section-z: 5;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(60% 80% at 12% 0%, rgb(79 166 141 / 0.3), transparent 60%),
      radial-gradient(55% 75% at 92% 100%, rgb(17 102 159 / 0.6), transparent 60%),
      var(--navy);
  }
  .process::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 25%, transparent 75%);
    mask-image: radial-gradient(ellipse at center, #000 25%, transparent 75%);
  }
  .process .container { position: relative; z-index: 1; }
  .process h2 { margin-bottom: var(--space-sm); color: #fff; }
  .process .lede { max-width: 72ch; margin: 0 0 var(--space-lg); color: rgb(255 255 255 / 0.82); }

  /* Desktop: all 10 steps visible, two rows of five, connector line threaded behind the cards */
  .steps {
    --gap: 16px;
    --pad-top: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-md) var(--gap);
  }
  .step {
    position: relative;
    text-align: center;
  }
  /* line from this circle's centre to the next circle's centre (hidden on the last step of a row) */
  .step::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: calc(var(--pad-top) + 19px);
    left: 50%;
    width: calc(100% + var(--gap));
    height: 2px;
    background: rgb(155 213 194 / 0.45);
  }
  .step:nth-child(5n)::before,
  .step:last-child::before { display: none; }

  /* step card: translucent glass, faded numeral behind the text, teal edge on hover */
  .step-card {
    position: relative;
    z-index: 1;
    isolation: isolate;
    overflow: hidden;
    height: 100%;
    padding: var(--pad-top) 12px 20px;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-card);
    transition: background-color 0.25s ease, border-color 0.25s ease,
      box-shadow 0.25s ease, transform 0.25s ease;
  }
  .step-card::after {
    content: attr(data-n);
    position: absolute;
    z-index: -1;
    right: 8px;
    bottom: -10px;
    font: 700 72px/1 var(--font-heading);
    color: rgb(255 255 255 / 0.07);
    pointer-events: none;
    transition: color 0.25s ease;
  }
  .step-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--teal-light);
    transform: scaleY(0);
    transition: transform 0.3s ease;
  }
  @media (hover: hover) {
    .step-card:hover {
      background: rgb(255 255 255 / 0.11);
      border-color: rgb(155 213 194 / 0.55);
      box-shadow: 0 8px 22px rgb(0 0 0 / 0.28);
      transform: translateY(-3px);
    }
