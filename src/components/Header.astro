---
import Logo from './Logo.astro';
import type { Strings } from '../i18n/en';
const { t } = Astro.props as { t: Strings };
const path = Astro.url.pathname;
const isActive = (p: string) => (p === '/en/' ? path === p : path.startsWith(p));
---
<header class="site-header" id="site-header">
  <div class="container bar">
    <Logo href={t.nav[0].path} />
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <svg class="i-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg class="i-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {t.nav.map((item) => (
          <li><a href={item.path} data-text={item.label} aria-current={isActive(item.path) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <div class="lang" role="group" aria-label="Language">
        <span aria-current="true">{t.langSwitch.current}</span>
        <span aria-hidden="true">|</span>
        <span class="lang-off" aria-disabled="true" title={t.langSwitch.otherLabel}>{t.langSwitch.other}</span>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--surface); box-shadow: var(--shadow-bar); transition: box-shadow .2s; }
  .site-header.scrolled { box-shadow: 0 6px 20px rgb(12 56 93 / .18); }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 72px; }
  .nav ul { display: flex; gap: var(--space-lg); list-style: none; margin: 0; padding: 0; }
  .nav a { display: inline-block; color: var(--navy); text-decoration: none; font-size: 14px; font-weight: 500; text-transform: uppercase; letter-spacing: .1em; padding: 6px 0; border-bottom: 2px solid transparent; }
  /* invisible bold copy reserves width so the bold state doesn't shift neighbours */
  .nav a::after { content: attr(data-text); display: block; height: 0; overflow: hidden; visibility: hidden; font-weight: 700; }
  .nav a:hover { color: var(--blue); border-bottom-color: var(--blue); }
  .nav a[aria-current='page'] { color: var(--blue); font-weight: 700; border-bottom-color: var(--blue); }
  .lang { display: flex; gap: 6px; font-size: 14px; letter-spacing: .06em; color: var(--navy); }
  .lang [aria-current] { font-weight: 700; }
  .lang-off { color: #6b747c; cursor: not-allowed; }
  .menu-toggle { display: none; background: none; border: 0; color: var(--navy); padding: 8px; cursor: pointer; }
  .menu-toggle .i-close { display: none; }
  .menu-toggle[aria-expanded='true'] .i-open { display: none; }
  .menu-toggle[aria-expanded='true'] .i-close { display: block; }

  /* Desktop: logo left, menu truly centred, language right */
  @media (min-width: 768px) {
    .bar { display: grid; grid-template-columns: 1fr auto 1fr; }
    .nav { display: contents; }
    .nav .lang { justify-self: end; }
  }

  @media (max-width: 767px) {
    .menu-toggle { display: block; }
    .nav { display: none; position: absolute; inset: 100% 0 auto 0; flex-direction: column; align-items: flex-start; gap: var(--space-sm); background: var(--surface); box-shadow: 0 8px 16px rgb(12 56 93 / .1); padding: var(--space-md) var(--gutter); }
    .nav.open { display: flex; }
    .nav ul { flex-direction: column; gap: var(--space-sm); }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('open')) { toggle?.click(); toggle?.focus(); }
  });
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
