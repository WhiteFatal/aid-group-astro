---
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource/noto-sans-georgian/400.css';
import '@fontsource/noto-sans-georgian/500.css';
import '@fontsource/noto-sans-georgian/600.css';
import '@fontsource/noto-sans-georgian/700.css';
import { strings, langFromPath, pageAlternates } from '../i18n';

const { title, description, image = '/og-image.jpg', pageClass } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = strings[lang];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Language alternates (hreflang). Only languages the page actually exists in are listed; English doubles as x-default.
const alternates = pageAlternates(Astro.url.pathname).map((a) => ({ ...a, href: new URL(a.path, Astro.site).href }));
const otherLocale = lang === 'ka' ? 'en_US' : 'ka_GE';
const hasOtherLanguage = alternates.length > 1;
const imageUrl = new URL(image, Astro.site).href;

// ProfessionalService JSON-LD — same on every page, identifies AID Group as an entity
// (as opposed to `canonicalUrl` above, which is this specific page's own address).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'AID Group',
  legalName: t.legalName,
  taxID: '405843084',
  url: new URL(`/${lang}/`, Astro.site).href,
  logo: new URL('/og-image.jpg', Astro.site).href,
  image: new URL('/og-image.jpg', Astro.site).href,
  description: t.footer.blurb,
  telephone: '+995571130335',
  email: 'aidgcec@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: t.contact.addressLines[0],
    addressLocality: t.city,
    postalCode: '0160',
    addressCountry: 'GE',
  },
  areaServed: 'GE',
  sameAs: ['https://www.facebook.com/profile.php?id=61593867286368'],
};

---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {hasOtherLanguage && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {hasOtherLanguage && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AID Group" />
    <meta property="og:locale" content={lang === 'ka' ? 'ka_GE' : 'en_US'} />
    {hasOtherLanguage && <meta property="og:locale:alternate" content={otherLocale} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipLink}</a>
    <Header t={t} />
    <main id="main" class={pageClass}><slot /></main>
    <Footer t={t} />
  </body>
</html>
